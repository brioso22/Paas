{
  "name": "paas-panel",
  "version": "0.1.0",
  "private": true,
  "description": "Panel web para gestionar un PaaS sobre Kubernetes (Minikube)",
  "type": "module",
  "main": "src/server.js",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "dev:seed": "node scripts/seed.js",
    "test": "node --test --test-concurrency=1 \"test/**/*.test.js\"",
    "lint": "node scripts/lint.js"
  },
  "license": "UNLICENSED",
  "dependencies": {
    "adm-zip": "^0.6.1",
    "bcryptjs": "^3.0.3",
    "better-sqlite3": "^12.11.1",
    "express": "^5.3.0",
    "express-session": "^1.19.0",
    "helmet": "^8.3.0",
    "multer": "^2.5.0"
  },
  "allowScripts": {
    "better-sqlite3@12.11.1": true
  }
}
