# Copia este archivo a .env y ajusta los valores. NUNCA subas .env al repositorio.
# deploy/install.sh genera SESSION_SECRET y SECRETS_KEY automáticamente.

# --- Servidor HTTP ---
PORT=8080
HOST=0.0.0.0
NODE_ENV=production

# Secreto para firmar la cookie de sesión (mínimo 32 caracteres).
# Genera uno con: node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
SESSION_SECRET=cambia-esto-por-un-valor-aleatorio-de-al-menos-32-caracteres
# Clave AES-256 (32 bytes en base64) para cifrar variables y tokens en la BD.
# Genera una con: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Si la pierdes, no podrás descifrar las variables guardadas.
SECRETS_KEY=AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA=

# Pon true solo si sirves el panel por HTTPS (activa cookie Secure y HSTS).
COOKIE_SECURE=false
SESSION_MAX_AGE_HOURS=12
# true si hay un proxy inverso delante (para leer X-Forwarded-*).
TRUST_PROXY=false

# --- Rutas ---
DATA_DIR=./data
WORKSPACES_DIR=./workspaces
CHART_PATH=~/paas-app-chart

# --- Clúster ---
DOMAIN=paas.local
TENANT_PREFIX=tenant-
INGRESS_IP=192.168.49.2
INGRESS_NODEPORT=32134
# NodePort del puerto 443 de ingress-nginx (kubectl get svc -n ingress-nginx)
INGRESS_HTTPS_NODEPORT=31703
PROMETHEUS_URL=http://localhost:9090
HELM_TIMEOUT=5m
KEEP_IMAGES=3

# --- Costos (USD por hora) ---
PRICE_CPU_HOUR=0.05
PRICE_RAM_GB_HOUR=0.01

# --- Límites ---
MAX_UPLOAD_MB=50
MAX_LOG_KB=512

# --- Publicación / webhooks ---
# URL con la que GitHub llegará al panel (se usa para mostrar la URL del webhook).
PUBLIC_BASE_URL=http://localhost:8080
# Proveedores: none (únicos implementados por ahora)
PUBLISH_PROVIDER=none

# true = no ejecuta kubectl/helm/minikube/git: solo registra los comandos.
DRY_RUN=false
